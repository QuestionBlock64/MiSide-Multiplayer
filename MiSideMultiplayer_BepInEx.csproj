<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MiSideMultiplayer</AssemblyName>
    <RootNamespace>MiSideMultiplayer</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RelayServer\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(MISIDE_GAME_DIR)' != ''">$(MISIDE_GAME_DIR)</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' and '$(GameDir)' != ''">$(GameDir)\BepInEx</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildProjectDirectory)\lib\BepInEx</BepInExDir>
    <InteropDir Condition="'$(InteropDir)' == ''">$(BepInExDir)\interop</InteropDir>
  </PropertyGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.Core.dll')"
           Text="BepInEx.Core.dll not found at '$(BepInExDir)\core\BepInEx.Core.dll'." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll')"
           Text="BepInEx.Unity.IL2CPP.dll not found. You need BepInEx 6 IL2CPP." />
    <Error Condition="!Exists('$(BepInExDir)\core\Il2CppInterop.Runtime.dll')"
           Text="Il2CppInterop.Runtime.dll not found. You need BepInEx 6 IL2CPP." />
    <Error Condition="!Exists('$(InteropDir)\UnityEngine.CoreModule.dll')"
           Text="UnityEngine.CoreModule.dll not found at '$(InteropDir)\UnityEngine.CoreModule.dll'. Run MiSide once with BepInEx installed." />
    <Error Condition="!Exists('$(InteropDir)\Il2Cppmscorlib.dll')"
           Text="Il2Cppmscorlib.dll not found. Run MiSide once with BepInEx installed." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx.Core"
               Condition="Exists('$(BepInExDir)\core\BepInEx.Core.dll')">
      <HintPath>$(BepInExDir)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"
               Condition="Exists('$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll')">
      <HintPath>$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime"
               Condition="Exists('$(BepInExDir)\core\Il2CppInterop.Runtime.dll')">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common"
               Condition="Exists('$(BepInExDir)\core\Il2CppInterop.Common.dll')">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony"
               Condition="Exists('$(BepInExDir)\core\0Harmony.dll')">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib"
               Condition="Exists('$(InteropDir)\Il2Cppmscorlib.dll')">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule"
               Condition="Exists('$(InteropDir)\UnityEngine.CoreModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule"
               Condition="Exists('$(InteropDir)\UnityEngine.PhysicsModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule"
               Condition="Exists('$(InteropDir)\UnityEngine.Physics2DModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule"
               Condition="Exists('$(InteropDir)\UnityEngine.AnimationModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"
               Condition="Exists('$(InteropDir)\UnityEngine.JSONSerializeModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule"
               Condition="Exists('$(InteropDir)\UnityEngine.AudioModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextMesh for name tags (Person/HeadMirror confirmed; TextMesh is in this DLL) -->
    <Reference Include="UnityEngine.TextRenderingModule"
               Condition="Exists('$(InteropDir)\UnityEngine.TextRenderingModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule"
               Condition="Exists('$(InteropDir)\UnityEngine.IMGUIModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule"
               Condition="Exists('$(InteropDir)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(InteropDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
